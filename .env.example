# Pipeline mode: which stages to run
#   transcribe - speech recognition only (plain text)
#   timestamps - speech recognition + timestamps (subtitles, no speakers)
#   diarize    - full pipeline with speaker diarization (default; needs HUGGINGFACE_TOKEN)
PIPELINE_MODE=diarize

# Hugging Face token for pyannote models (Required for diarize mode only)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Optional: OpenAI API key if using OpenAI Whisper API instead of local model
OPENAI_API_KEY=your_openai_api_key_here

# Model configurations
WHISPER_MODEL=base  # tiny, base, small, medium, large, large-v2, large-v3
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1  # diarize mode only

# Output configurations
# txt, srt, vtt, json. Leave empty to use the mode's default
# (txt for transcribe, srt otherwise). transcribe mode only supports txt.
OUTPUT_FORMAT=
SPEAKER_LABELS=Speaker  # prefix for speaker labels (diarize mode only)

# min and max speakers for diarization (optional), leave it empty if no constraint
MIN_SPEAKERS=
MAX_SPEAKERS=

# Model used for quickstart.py
QUICKSTART_WHISPER_MODEL=tiny
